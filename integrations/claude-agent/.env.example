# Copy to `.env` (same directory) and fill in. `.env` is gitignored — the token
# stays on this machine and is never committed.
#
# Get a long-lived, subscription-backed token by running, in a normal terminal:
#
#     claude setup-token
#
# It requires an interactive sign-in. Paste the resulting token below.

ANTHROPIC_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Model backing CSM's probe/recall/synthesis stages through this sidecar.
# claude-sonnet-5 is the default: it is the testing/iteration instrument, and
# the judge calibration (rho 0.864 vs the official Gemini judge) was established
# on it. claude-opus-5 is available on explicit request; claude-haiku-4-5 is far
# cheaper for high-volume probe stages. Numbers produced through this sidecar
# are iteration-only and are never pooled with official or Gemini figures.
# CSM_AGENT_MODEL=claude-sonnet-5

# Port the sidecar listens on (CSM's AgentSdkProvider defaults to the same).
# CSM_AGENT_PORT=8787
