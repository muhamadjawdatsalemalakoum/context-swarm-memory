# Copy to .env for local use. Never commit real keys.
# The csm CLI auto-loads .env on startup (src/utils/loadEnv.ts); shell-exported
# vars override anything set here.

# Default is mock, which requires no network and no API keys.
CSM_PROVIDER=mock

# Gemini API path. The provider accepts either GEMINI_API_KEY or GOOGLE_API_KEY.
# GEMINI_API_KEY=replace-me
# GOOGLE_API_KEY=replace-me
# CSM_PROVIDER=gemini
# CSM_GEMINI_MODEL=gemini-3.5-flash
# CSM_GEMINI_THINKING=low
# Thinking floor used for disableThinking stages (probe) and the "none" mode.
# gemini-3.5-flash accepts "minimal" (0 thought tokens); gemini-3-pro needs "low".
# CSM_GEMINI_THINKING_MIN=minimal

# Probe/recall concurrency. Default: parallel for hosted providers
# (gemini/openai/anthropic), serial for local ollama/llama-server. Set 0 when
# pointing the "openai" provider at a local OpenAI-compat endpoint.
# CSM_PARALLEL_PROBES=1

# Recommended on Gemini: route the cheap probe stage to flash-lite.
# Gated 2026-06-10 (29/30 on PaySwift 30q, -1.8s avg pipeline, -9% input
# tokens vs 3.5-flash probes). See docs/PERF_BREAKDOWN.md before changing
# recall/synth models — those need fresh gates.
# CSM_PROBE_MODEL=gemini-2.5-flash-lite

# Opt-in: start qualifying recalls on their own probe's completion instead of
# the probe barrier (discarded calls are token-counted). Measured no-op on
# PaySwift; may help under retry/straggler-heavy conditions.
# CSM_EAGER_RECALLS=0

# Coverage/chronicle mode (T1): default ON since 2026-06-10 — coverage-shaped
# queries (summaries, ordering, temporal arithmetic, aggregation) get bigger
# recall digests and a deterministic, cited packet timeline. =0 restores the
# pre-coverage pipeline byte-identically. Gates: docs/experiments/EXP-T1-coverage.md.
# CSM_COVERAGE=1

# Hybrid router (T2): opt-in. Proven offline and on BEAM-shaped fixtures but
# flat at 100k scale (PaySwift parity +6.4% tokens; BEAM-slice inside CIs);
# re-gate on a 500k slice before scale runs. docs/experiments/EXP-T2-router.md.
# CSM_ROUTER_HYBRID=0

# Gemini context-cache mode (T4): off | implicit-observe | explicit. Default
# off is byte-identical to the pre-T4 provider. docs/experiments/EXP-T4-gemini-caching.md.
# CSM_GEMINI_CACHE=off

# AMB bridge (scripts/amb-csm-retrieve.ts) knobs:
# CSM_AMB_WITH_INTERNAL_ANSWER=0   # 1 restores the legacy discarded answer call (A/B only)
# CSM_AMB_ALLOW_MOCK=0             # 1 lets the bridge run on MockProvider for plumbing tests

# Ingestion-time Observation (warm server only, scripts/amb-csm-server.ts):
# default OFF. When ON, retrospective summary/order queries get a write-time
# organized memory built ONCE over the full conversation (cached per user;
# hierarchical map-reduce above ~700K tokens). Measured on BEAM 100k
# summarization: 0.714 -> 0.936 at ~43% less answer-visible context.
# CSM_AMB_OBSERVE_MEMORY=0
# CSM_AMB_OBSERVE_MAX_OUTPUT=12000        # final organized-memory size (proven-run value = the default)
# CSM_AMB_OBSERVE_SINGLE_PASS_TOKENS=700000  # <= this: one flash call
# CSM_AMB_OBSERVE_CHUNK_TOKENS=600000     # map-chunk input budget (large convs)
# CSM_AMB_OBSERVE_CHUNK_OUTPUT=3000       # per-chunk summary size
# CSM_AMB_OBSERVE_MAP_CONCURRENCY=4       # bound concurrent map calls (TPM quota)
# CSM_AMB_SYNTH_RAW_DOCS=10               # raw docs returned after the organized memory

# Gemini OpenAI-compatible sidecar path. Use this only for SOTA sidecar LLM
# calls; embeddings may still be local/Ollama depending on the sidecar.
# CSM_OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# OPENAI_API_KEY=replace-me
# CSM_GEMINI_REASONING_EFFORT=low

# Local Ollama/Gemma path.
# CSM_PROVIDER=ollama
# CSM_OPENAI_BASE_URL=http://localhost:11434/v1
# CSM_PROBE_MODEL=gemma4:e4b
# CSM_RECALL_MODEL=gemma4:31b
# CSM_SYNTH_MODEL=gemma4:31b

# Hosted OpenAI-compatible path.
# CSM_PROVIDER=openai
# OPENAI_API_KEY=replace-me
# CSM_OPENAI_MODEL=replace-me
